{
  "name": "conventional-commit-msg",
  "author": "Łukasz Jerciński",
  "license": "MIT",
  "version": "1.0.0",
  "description": "Zero-config commitlint frontend for conventional commits",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jercik/conventional-commit-msg.git"
  },
  "type": "module",
  "bin": {
    "conventional-commit-msg": "bin/conventional-commit-msg"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "prepublishOnly": "pnpm run rebuild",
    "build": "tsc -p tsconfig.app.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fta": "fta-check",
    "knip": "knip",
    "lint": "eslint",
    "rebuild": "pnpm run clean && pnpm run build",
    "start": "pnpm -s run rebuild && node bin/conventional-commit-msg",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "keywords": [],
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@commitlint/format": "^20.2.0",
    "@commitlint/lint": "^20.3.0",
    "@commitlint/load": "^20.3.0",
    "@commitlint/read": "^20.2.0",
    "@commitlint/types": "^20.2.0",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "^4.0.16",
    "eslint": "^9.39.2",
    "eslint-config-axkit": "^1.1.0",
    "fta-check": "^1.5.1",
    "fta-cli": "^3.0.0",
    "knip": "^5.80.0",
    "prettier": "3.7.4",
    "semantic-release": "^25.0.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
