{
  "name": "@j4k-oss/conventional-commit-msg",
  "version": "1.0.0",
  "description": "Zero-config commitlint frontend for conventional commits",
  "keywords": [],
  "homepage": "https://code.j4k.dev/j4k-oss/conventional-commit-msg#readme",
  "bugs": {
    "url": "https://code.j4k.dev/j4k-oss/conventional-commit-msg/issues"
  },
  "license": "MIT",
  "author": "Łukasz Jerciński",
  "repository": {
    "type": "git",
    "url": "https://code.j4k.dev/j4k-oss/conventional-commit-msg.git"
  },
  "bin": {
    "conventional-commit-msg": "bin/conventional-commit-msg"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "registry": "https://code.j4k.dev/api/packages/j4k-oss/npm/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:dts": "node scripts/check-dts.ts",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --check --config .oxfmtrc.json .",
    "fta": "fta-check",
    "knip": "knip",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "prepack": "pnpm run rebuild",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then hooks_path=$(git config --local --get-all core.hooksPath 2>/dev/null && echo .) && [ \"$hooks_path\" = \"$(echo .githooks; echo .)\" ] || git config core.hooksPath .githooks; fi",
    "rebuild": "pnpm run clean && pnpm run build",
    "start": "pnpm -s run rebuild && node bin/conventional-commit-msg",
    "test": "vitest run",
    "test:affected": "pnpm run test --since-last-run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -b tsconfig.check.json tsconfig.test.json tsconfig.scripts.json tsconfig.app.json tsconfig.build.json --noEmit",
    "validate:packed-packages": "node scripts/validate-packed-packages.ts --packer npm"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/format": "^21.0.1",
    "@commitlint/lint": "^21.0.2",
    "@commitlint/load": "^21.0.2",
    "@commitlint/read": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@j4k-oss/fta-check": "^1.6.3",
    "@j4k/oxlint-config": "^2.14.12",
    "@j4k/semantic-release-forgejo": "^1.2.5",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "fta-cli": "^3.1.0",
    "knip": "^6.44.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "publint": "^0.3.25",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "j4k": {
    "alignDtsCheck": true,
    "alignModuleContract": "esm-only"
  }
}
