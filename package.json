{
  "name": "conventional-commit-msg",
  "version": "1.0.0",
  "description": "Zero-config commitlint frontend for conventional commits",
  "keywords": [],
  "license": "MIT",
  "author": "Łukasz Jerciński",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jercik/conventional-commit-msg.git"
  },
  "bin": {
    "conventional-commit-msg": "bin/conventional-commit-msg"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.app.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "format": "oxfmt --config .oxfmtrc.json .",
    "format:check": "oxfmt --check --config .oxfmtrc.json .",
    "fta": "fta-check",
    "knip": "knip",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives .",
    "prepack": "pnpm run rebuild",
    "prepare": "git config core.hooksPath .githooks",
    "rebuild": "pnpm run clean && pnpm run build",
    "start": "pnpm -s run rebuild && node bin/conventional-commit-msg",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsgo -b --noEmit"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/format": "^20.5.0",
    "@commitlint/lint": "^20.5.3",
    "@commitlint/load": "^20.5.3",
    "@commitlint/read": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^25.9.2",
    "@typescript/native-preview": "beta",
    "@vitest/coverage-v8": "^4.1.8",
    "fta-check": "^1.5.3",
    "fta-cli": "^3.0.0",
    "knip": "^6.16.1",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-config-j4k": "^2.7.2",
    "oxlint-tsgolint": "^0.23.0",
    "semantic-release": "^25.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.5.1"
}
