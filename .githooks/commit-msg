#!/usr/bin/env bash
# Native Git hook - enable with: git config core.hooksPath .githooks
set -euo pipefail

# This repository publishes the bin, and pnpm never links a package into its own node_modules/.bin, so run the exact released version instead.
exec npm exec --yes --package=conventional-commit-msg@1.0.8 -- conventional-commit-msg "$1"
